<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen game theme: no status bar, draw into the display cutout, black window
         background (matches the pillarbox). Nav-bar hiding (immersive sticky) is done from
         native code via JNI — a theme cannot express it. -->
    <style name="GameTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
