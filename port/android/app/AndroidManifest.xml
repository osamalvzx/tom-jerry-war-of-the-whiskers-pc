<?xml version="1.0" encoding="utf-8"?>
<!-- WOTW (Tom & Jerry: War of the Whiskers) Android port. Side-load only; ships NO game
     data (the user supplies their own ISO via SAF; extraction happens on-device). No
     MANAGE_EXTERNAL_STORAGE, no storage permission — SAF hands a file descriptor. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.wotw.port"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="@string/app_name"
        android:hasCode="false"
        android:allowBackup="false"
        android:extractNativeLibs="true">

        <!-- Pure native activity (no Java yet). The SAF launcher activity is added when the
             ISO picker + extraction land; this milestone is the on-device GLES bring-up. -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="tjapp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
