// Icon + version stamp for the game executable itself. Without this the installed game is a
// blank-icon "tj_loader.exe" in the folder, which is exactly as unhelpful as it sounds.
// The artwork is ORIGINAL (see port/src/setup/tjsetup.ico) -- nothing here comes off the disc.
#include <windows.h>

1 ICON "../setup/tjsetup.ico"

1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS         0x4L
FILETYPE       0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Tom & Jerry: War of the Whiskers"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "ProductName",     "Tom & Jerry: War of the Whiskers (PC port)"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
